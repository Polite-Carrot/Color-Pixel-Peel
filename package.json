{
  "name": "color-pixel-peel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A mobile puzzle game: peel layers of colored pixels to clear the board.",
  "scripts": {
    "dev": "vite build --watch",
    "serve": "vite preview --outDir . --port 5173 --host",
    "build": "tsc --noEmit && vite build && node stamp.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "npm run build && node sync-web.js && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
